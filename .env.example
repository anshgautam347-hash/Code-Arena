# Copy this file to ".env" (which is git-ignored) and fill it in. Never commit real tokens.
# The code runner is an external Judge0 server. Without JUDGE0_URL nothing can be evaluated.
JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=
# JUDGE0_AUTH_HEADER=X-Auth-Token
# JUDGE0_EXTRA_HEADERS={"X-Example":"value"}

